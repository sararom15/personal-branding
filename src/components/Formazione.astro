---
import InteractiveBackground from './InteractiveBackground.astro';

const education = [
  {
    institution: "Università LUMSA, Roma",
    degree: "Master di II livello - Comunicazione Digitale, AI e Innovazione nel Marketing",
    year: "2025 - 2026",
    description: "Questo percorso ha aggiunto una dimensione strategica alla mia formazione tecnica.<br/>Ho approfondito marketing data-driven, AI applicata a funnel e personalizzazione dei contenuti, sentiment analysis e machine learning per l’analisi comportamentale, search engine marketing basato su analisi avanzate delle performance.<br/><br/>Qui ho consolidato una convinzione:<br/>la tecnologia è potente solo quando è inserita in un ecosistema coerente di comunicazione e strategia."
  },
  {
    institution: "Università degli Studi di Genova",
    degree: "Laurea Magistrale - Robotics Engineering",
    year: "2019 - 2021",
    description: "Automazione robotica, intelligenza artificiale, controllo dei sistemi complessi.<br/>Tesi in Python dedicata allo sviluppo di un algoritmo di localizzazione e navigazione per robot in ambienti affollati.<br/><br/>Qui ho sviluppato il mio pensiero strutturato:<br/><strong>definire un problema, modellarlo matematicamente, validarlo, ottimizzarlo.</strong><br/><br/>È la base su cui ancora oggi progetto architetture software."
  },
  {
    institution: "Leibniz University Hannover (Germany)",
    degree: "Erasmus +",
    year: "2019",
    description: "Esperienza nel campo della soft robotics.<br/>Progettazione e sviluppo di un Soft Pneumatic Gripper: modellazione 3D, analisi FEA, stampa 3D.<br/><br/>Un contesto internazionale che mi ha insegnato il valore della contaminazione tra discipline e culture."
  },
  {
    institution: "Università Politecnica delle Marche, Ancona",
    degree: "Laurea Triennale - Ingegneria Meccanica",
    year: "2015 - 2019",
    description: "Progettazione meccanica, modellazione fisica dei processi industriali, sistemi di automazione.<br/><br/>Qui ho costruito il metodo:<br/><strong>analisi rigorosa, scomposizione dei problemi complessi, orientamento alla soluzione.</strong>"
  }
];
---

<section id="formazione">
  <InteractiveBackground />
  <div class="container small-container">
    <div class="section-header">
      <h2 class="section-title">Formazione</h2>
      <p class="section-subtitle">Imparare. Evolvere. Migliorare.</p>
    </div>
    <div class="education-list">
      {education.map(item => (
        <div class="edu-item">
          <div class="edu-year">{item.year}</div>
          <div class="edu-details">
            <h3>{item.degree}</h3>
            <span class="institution">{item.institution}</span>
            <p class="edu-description" set:html={item.description}></p>
          </div>
        </div>
      ))}
    </div>

    <!-- Concluding Philosophy Block -->
    <div class="education-footer">
       <p>
         L'ingegneria mi ha insegnato il <strong class="highlight">metodo</strong>.<br/>
         La comunicazione digitale mi ha insegnato il <strong class="highlight">contesto</strong>.
       </p>
       <p>
         Nel primo caso ho imparato a progettare sistemi complessi, nel secondo, a capire dove e perché inserirli.
       </p>
      <div class="final-statement">
         <p>
           Algoritmi di navigazione autonoma, machine learning, architetture di marketing data-driven, AI applicata a funnel, contenuti, analisi semantica non sono percorsi separati.<br/>
           Sono due prospettive sulla stessa domanda:
         </p>
         <h3 class="big-question">
           Come possiamo usare la tecnologia<br/>per generare decisioni migliori?
         </h3>

      </div>
    </div>

  </div>
</section>

<style>
  #formazione {
    position: relative;
    overflow: hidden;
  }

  .container {
    position: relative;
    z-index: 2;
  }

  .small-container {
    max-width: 800px;
  }

  .education-list {
    margin-top: 3rem;
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .edu-item {
    display: flex;
    gap: 2rem;
    align-items: flex-start;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .edu-item:last-child {
    border-bottom: none;
  }

  .edu-year {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-primary);
    min-width: 120px;
    flex-shrink: 0;
  }

  .edu-details h3 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .institution {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    display: block;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .edu-description {
    color: #cccccc;
    font-size: 1rem;
    line-height: 1.6;
  }

  /* Footer Philosophy Styles */
  .education-footer {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--color-border);
    text-align: center;
  }

  .education-footer p {
    font-size: 1.1rem;
    line-height: 1.6;
    color: #cccccc;
    margin-bottom: 1.5rem;
  }

  .keywords-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
    margin: 2rem 0;
  }

  .keywords-grid span {
    background: rgba(255, 92, 0, 0.1);
    color: var(--color-primary);
    padding: 0.5rem 1rem;
    border-radius: 20px;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid rgba(255, 92, 0, 0.2);
  }

  .final-statement {
    margin-top: 3rem;
  }
  
  .big-question {
    font-family: var(--font-serif); /* Use Playfair Display */
    font-size: 2rem;
    font-weight: 700;
    margin-top: 1.5rem;
    line-height: 1.3;
    background: linear-gradient(90deg, #fff, var(--color-primary));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    display: inline-block;
  }

  .cv-container {
    margin-top: 2.5rem;
  }

  .highlight {
    color: var(--color-primary);
  }

  @media (max-width: 600px) {
    .edu-item {
      flex-direction: column;
      gap: 0.5rem;
    }
    
    .edu-year {
      min-width: auto;
    }
  }
</style>
