---
import Brand from './Brand.astro';
const currentYear = new Date().getFullYear();
---
<footer class="footer">
  <div class="container footer-content">
    <a href="#hero" aria-label="Sara Romano, inizio pagina"><Brand compact /></a>
    <p class="footer-manifesto">People. Data. Innovation.<br /><em>A more human tech future.</em></p>
    <p class="copyright">© {currentYear} Sara Romano<br />Tutti i diritti riservati.</p>
  </div>
</footer>
<style>
  .footer { padding: 2.5rem 0; background: var(--color-bg); }
  .footer-content { display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .footer-manifesto { font-family: var(--font-mono); margin: 0; font-size: .875rem; line-height: 1.9; }
  .footer-manifesto em { font-family: var(--font-serif); font-size: 1.1rem; }
  .copyright { font-family: var(--font-mono); font-size: .75rem; color: var(--color-text-muted); text-align: right; margin: 0; }
  @media (max-width: 767px) { .footer { padding-block: 2rem 4.5rem; } .footer-content { flex-wrap: wrap; gap: 1.5rem; } .footer-content > a { width: 100%; } .footer-manifesto { font-size: .8125rem; } .copyright { font-family: var(--font-mono); font-size: .75rem; } }
</style>
