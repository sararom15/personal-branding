---
import { ArrowUpRight, Mail, Phone, X } from '@lucide/astro';
import Brand from './Brand.astro';
import SocialIcon from './SocialIcon.astro';

const phoneNumber = '+393273921925';
const contactLinks = [
  { name: 'WhatsApp', href: `https://wa.me/${phoneNumber.replace(/\D/g, '')}`, external: true },
  { name: 'Telefono', href: `tel:${phoneNumber}`, external: false },
  { name: 'LinkedIn', href: 'https://www.linkedin.com/in/sara-romano-1368591b7', external: true },
  { name: 'Email', href: 'mailto:sara.romano.15@gmail.com', external: false },
];
---

<div id="floating-contact" class="floating-contact" aria-hidden="true" inert>
  <button id="contact-toggle" type="button" class="contact-launcher" aria-label="Parliamone: apri i contatti rapidi" aria-expanded="false" aria-controls="contact-options" tabindex="-1">
    <span class="contact-label">Parliamone <span class="contact-open-icon"><ArrowUpRight size={17} stroke-width={1.2} aria-hidden="true" /></span><span class="contact-close-icon"><X size={17} stroke-width={1.2} aria-hidden="true" /></span></span>
    <span class="contact-mark" aria-hidden="true"><Brand compact monogramOnly /></span>
  </button>
  <nav id="contact-options" class="contact-options" aria-label="Contatti rapidi" hidden>
    {contactLinks.map(link => (
      <a class="contact-option" href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>
        <span>{link.name}</span>
        <span class="contact-option-icon" aria-hidden="true">
          {link.name === 'Telefono' ? <Phone size={19} stroke-width={1.3} /> : link.name === 'Email' ? <Mail size={19} stroke-width={1.3} /> : <SocialIcon name={link.name} />}
        </span>
      </a>
    ))}
  </nav>
</div>

<script>
  const widget = document.querySelector<HTMLElement>('#floating-contact');
  const launcher = document.querySelector<HTMLButtonElement>('#contact-toggle');
  const options = document.querySelector<HTMLElement>('#contact-options');
  const hero = document.querySelector<HTMLElement>('#hero');
  const contacts = document.querySelector<HTMLElement>('#contatti');

  if (widget && launcher && options && hero && contacts) {
    let frame = 0;
    let heroEnd = 0;
    let contactVisible = false;
    let wasVisible = false;

    const setOpen = (open: boolean, restoreFocus = false) => {
      options.hidden = !open;
      launcher.setAttribute('aria-expanded', String(open));
      launcher.setAttribute('aria-label', `Parliamone: ${open ? 'chiudi' : 'apri'} i contatti rapidi`);
      if (restoreFocus) launcher.focus({ preventScroll: true });
    };

    launcher.addEventListener('click', () => setOpen(options.hidden));
    document.addEventListener('click', event => {
      if (!options.hidden && event.target instanceof Node && !widget.contains(event.target)) setOpen(false);
    });
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape' && !options.hidden) {
        event.preventDefault();
        setOpen(false, true);
      }
    });
    widget.addEventListener('focusout', event => {
      if (!(event.relatedTarget instanceof Node) || !widget.contains(event.relatedTarget)) setOpen(false);
    });
    options.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(link => {
      link.addEventListener('click', () => setOpen(false, true));
    });

    const render = () => {
      frame = 0;
      const visible = window.scrollY >= heroEnd - 2 && !contactVisible;
      // Replay the entrance only when the launcher reappears, never on every scroll.
      if (visible === wasVisible) return;
      wasVisible = visible;
      if (!visible) setOpen(false);
      widget.classList.toggle('is-visible', visible);
      widget.inert = !visible;
      launcher.tabIndex = visible ? 0 : -1;
      widget.setAttribute('aria-hidden', String(!visible));
    };
    const schedule = () => { if (!frame) frame = requestAnimationFrame(render); };
    const measure = () => {
      const headerHeight = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-height')) || 80;
      heroEnd = hero.getBoundingClientRect().bottom + window.scrollY - headerHeight;
      schedule();
    };

    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', measure, { passive: true });
    new ResizeObserver(measure).observe(hero);
    new IntersectionObserver(([entry]) => {
      contactVisible = entry.isIntersecting;
      schedule();
    }, { rootMargin: '0px 0px -80px 0px' }).observe(contacts);
    measure();
  }
</script>

<style>
  .floating-contact { position: fixed; right: 24px; bottom: max(20px, env(safe-area-inset-bottom)); z-index: 40; opacity: 0; visibility: hidden; transform: translateY(16px) scale(.9); transform-origin: right bottom; transition: opacity .2s, visibility .2s, transform .25s; }
  .floating-contact.is-visible { opacity: 1; visibility: visible; transform: none; }
  .contact-launcher { display: flex; align-items: center; padding: 5px; border: 1px solid var(--color-border); border-radius: 60px; background: var(--color-bg); color: var(--color-text); box-shadow: 0 6px 24px rgb(61 43 28 / 12%); cursor: pointer; transition: border-color .2s, box-shadow .2s; }
  .contact-label { font-family: var(--font-serif); display: inline-flex; align-items: center; gap: .5rem; min-width: 0; max-width: 0; padding-inline: 0; overflow: hidden; white-space: nowrap; font-size: 1.0625rem; letter-spacing: .08em; opacity: 0; transform: translateX(10px); transition: max-width .4s, padding-inline .4s, opacity .15s, transform .4s; }
  .is-visible .contact-label { max-width: 160px; padding-inline: .95rem .85rem; opacity: 1; transform: none; transition: max-width .6s cubic-bezier(.22,1,.36,1) .2s, padding-inline .6s cubic-bezier(.22,1,.36,1) .2s, opacity .3s .35s, transform .55s .25s; }
  .contact-label :global(svg) { color: var(--color-primary); transition: transform .25s; }
  .contact-open-icon, .contact-close-icon { display: inline-flex; }
  .contact-close-icon, [aria-expanded="true"] .contact-open-icon { display: none; }
  [aria-expanded="true"] .contact-close-icon { display: inline-flex; }
  .contact-options { position: absolute; right: 0; bottom: calc(100% + 6px); display: flex; flex-direction: column; align-items: flex-end; gap: .6rem; width: max-content; max-width: calc(100vw - 48px); max-height: calc(100dvh - var(--header-height) - 120px - env(safe-area-inset-bottom)); overflow-y: auto; overscroll-behavior: contain; padding: 7px; margin-right: -7px; }
  .contact-options[hidden] { display: none; }
  .contact-option { display: flex; align-items: center; justify-content: space-between; gap: 1rem; min-width: 164px; min-height: 48px; padding: 6px 7px 6px 20px; border: 1px solid var(--color-border); border-radius: 50px; background: var(--color-bg); color: var(--color-text); box-shadow: 0 3px 8px rgb(61 43 28 / 10%); font-family: var(--font-serif); font-size: 1.0625rem; letter-spacing: .04em; transition: color .2s, border-color .2s, background .2s; }
  .contact-option-icon { display: grid; place-items: center; width: 34px; height: 34px; flex-shrink: 0; border-radius: 50%; background: var(--color-surface); color: var(--color-primary); }
  .contact-option:hover, .contact-option:focus-visible { border-color: var(--color-primary); color: var(--color-primary); background: var(--color-surface); }
  .contact-mark { display: grid; place-items: center; position: relative; flex-shrink: 0; width: 60px; height: 60px; border-radius: 50%; background: var(--color-surface); }
  .contact-mark :global(.brand) { transform: scale(.68); }
  .contact-mark::after { content: ''; position: absolute; inset: -1px; border: 1px solid var(--color-primary); border-radius: 50%; opacity: 0; pointer-events: none; }
  .contact-launcher:hover, .contact-launcher:focus-visible { color: var(--color-primary); border-color: var(--color-primary); box-shadow: 0 8px 26px rgb(61 43 28 / 17%); }
  .contact-launcher:hover .contact-open-icon :global(svg) { transform: translate(2px, -2px); }
  @media (prefers-reduced-motion: no-preference) {
    .is-visible .contact-launcher { animation: contact-arrive .65s cubic-bezier(.16,1,.3,1) both; }
    .is-visible .contact-mark::after { animation: contact-ripple 1.15s ease-out .35s both; }
    .contact-options:not([hidden]) { animation: contact-options-in .2s ease-out both; }
  }
  @keyframes contact-options-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @keyframes contact-arrive {
    0% { opacity: 0; transform: translateY(24px) scale(.65); }
    65% { opacity: 1; transform: translateY(-3px) scale(1.025); }
    100% { opacity: 1; transform: none; }
  }
  @keyframes contact-ripple {
    0% { opacity: 0; transform: scale(.92); }
    18% { opacity: .45; }
    100% { opacity: 0; transform: scale(1.55); }
  }
  @media (max-width: 767px) {
    .floating-contact { right: 12px; bottom: max(12px, env(safe-area-inset-bottom)); }
    .contact-launcher { padding: 4px; }
    .contact-options { max-width: calc(100vw - 24px); max-height: calc(100dvh - var(--header-height) - 88px - env(safe-area-inset-bottom)); }
    .contact-label { font-size: 1rem; letter-spacing: .04em; }
    .is-visible .contact-label { padding-inline: .8rem .65rem; }
    .contact-mark { width: 44px; height: 44px; }
    .contact-mark :global(.brand) { transform: scale(.56); }
  }
  @media (max-height: 500px) { .contact-label { font-family: var(--font-serif); display: none; } .contact-launcher { padding: 4px; } .contact-mark { width: 40px; height: 40px; } .contact-mark :global(.brand) { transform: scale(.52); } }
  @media (prefers-reduced-motion: reduce) { .floating-contact, .contact-launcher, .contact-label { transform: none; transition: none; } .is-visible .contact-label { transition: none; } }
</style>
