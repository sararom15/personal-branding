---
import { Plus, ArrowUpRight, Download } from '@lucide/astro';

const chapters = [
  {
    number: '01',
    title: 'Capire i sistemi.',
    theme: 'Il metodo',
    years: '2015 / 2021',
    intro: "L'ingegneria mi ha insegnato a guardare dentro un problema: scomporlo, costruire un modello, verificare una soluzione.",
    milestones: [
      { date: '2015 - 2019', title: 'Ingegneria Meccanica', place: 'Università Politecnica delle Marche', text: 'Le basi: analisi, progettazione e comprensione dei processi industriali.' },
      { date: '2019', title: 'Erasmus+ / Soft robotics', place: 'Leibniz University Hannover', text: 'Progettazione e prototipazione in un contesto internazionale.' },
      { date: '2019 - 2021', title: 'Robotics Engineering', place: 'Università degli Studi di Genova', text: 'AI, controllo e sistemi complessi. Una tesi in Python sulla navigazione di robot in ambienti affollati.' },
    ],
    value: 'Individuare il problema giusto, prima di scegliere la tecnologia.',
    skills: ['Analisi dei processi', 'AI & robotica', 'Progettazione'],
  },
  {
    number: '02',
    title: 'Farli lavorare.',
    theme: "L'esperienza",
    years: '2022 / 2025',
    intro: "Tre anni in Reply hanno portato quel metodo dentro le aziende: processi reali, sistemi da integrare, automazioni che devono funzionare ogni giorno.",
    milestones: [
      { date: '2022 - 2025', title: 'Hyperautomation Developer', place: 'Sprint Reply / Milano', text: "RPA, processi enterprise e scalabilità. Dall'analisi del flusso di lavoro alla costruzione dell'automazione." },
    ],
    value: 'Collegare gli strumenti, ridurre le attività ripetitive e rendere i processi più efficienti.',
    skills: ['Hyperautomation', 'RPA', 'Integrazione dei sistemi'],
  },
  {
    number: '03',
    title: 'Connetterli alle persone.',
    theme: 'La visione',
    years: '2025 / Oggi',
    intro: "Oggi unisco sviluppo AI e visione strategica. Perché innovare riguarda anche come un'impresa decide, comunica e fa crescere le proprie persone.",
    milestones: [
      { date: '2025 - Oggi', title: 'Automation & AI Architect', place: 'Asernet / Foggia', text: 'Progetto architetture che integrano dati, AI e processi aziendali. Tra queste Datapyx, una piattaforma modulare per trasformare i dati in decisioni e azioni operative.' },
      { date: '2025 - 2026', title: 'Comunicazione Digitale, AI e Innovazione nel Marketing', place: 'Master di II livello / Università LUMSA', text: 'La prospettiva strategica: marketing data-driven, comunicazione digitale e AI applicata a contenuti e analisi.' },
    ],
    value: "Unire tecnologia, comunicazione e formazione in un percorso di innovazione coerente.",
    skills: ['AI engineering', 'Digital innovation', 'Communication'],
  },
];
---

<section id="esperienze" aria-labelledby="journey-title">
  <div class="container">
    <div class="journey-heading section-header">
      <span class="eyebrow">04 / Esperienze &amp; formazione</span>
      <h2 id="journey-title" class="section-title">Un percorso.<br /><em>Più prospettive.</em></h2>
      <p class="journey-description">Dall'ingegneria alla comunicazione, passando per l'AI.<br />Ogni tappa aggiunge un modo di capire la tua impresa.</p>
    </div>
    <div class="journey-layout">
      <aside class="journey-intro">
        <p class="journey-thought">La curiosità<br />tiene insieme tutto.</p>
        <p class="journey-note">La tecnica mi dà il metodo.<br />La comunicazione, il contesto.<br /><strong>Insieme, una visione d'insieme.</strong></p>
        <a href="/CV_SaraRomano.pdf" class="text-link" download><Download size={18} /> Il percorso completo nel CV</a>
      </aside>
      <div class="chapters">
        {chapters.map((chapter, index) => (
          <details class="chapter" open={index === 2}>
            <summary>
              <span class="chapter-number">{chapter.number}</span>
              <span class="chapter-heading"><span class="chapter-meta">{chapter.theme} <span>{chapter.years}</span></span><span class="chapter-title">{chapter.title}</span></span>
              <Plus class="chapter-toggle" size={24} />
            </summary>
            <div class="chapter-body">
              <p class="chapter-intro">{chapter.intro}</p>
              <ol class="milestones">
                {chapter.milestones.map(item => (
                  <li>
                    <span class="milestone-date">{item.date}</span>
                    <h3>{item.title}</h3>
                    <p class="milestone-place">{item.place}</p>
                    <p>{item.text}</p>
                  </li>
                ))}
              </ol>
              <div class="business-value"><span class="eyebrow">Per la tua azienda</span><p>{chapter.value}</p></div>
              <ul class="skills" aria-label="Competenze">{chapter.skills.map(skill => <li>{skill}</li>)}</ul>
            </div>
          </details>
        ))}
      </div>
    </div>
    <div class="journey-outcome">
      <p>AI Engineer <span>/</span><br />Digital Innovation &amp; Communication</p>
      <a href="#contatti" class="text-link">Mettiamo queste competenze al lavoro <ArrowUpRight size={20} /></a>
    </div>
  </div>
</section>

<script>
  const chapters = document.querySelectorAll<HTMLDetailsElement>('.chapter');
  chapters.forEach(chapter => {
    chapter.addEventListener('toggle', () => {
      if (chapter.open) chapters.forEach(other => { if (other !== chapter) other.open = false; });
    });
  });
</script>

<style>

  #esperienze { background: #efebe3; border-block: 1px solid var(--color-border); }
  .journey-heading { margin-bottom: 3.5rem; }
  .journey-heading h2 { font-size: clamp(3rem,5vw,4.5rem); line-height: 1.05; }
  .journey-description { font-family: var(--font-mono); color: var(--color-text-muted); margin: 1.5rem 0 0; font-size: .9375rem; }
  .journey-layout { display: grid; grid-template-columns: minmax(0,.8fr) minmax(0,1.5fr); gap: 7%; align-items: start; }
  .journey-intro { position: sticky; top: calc(var(--header-height) + 2rem); border-top: 1px solid var(--color-primary); padding-top: 1.6rem; }
  .journey-thought { max-width: 350px; font-family: var(--font-serif); font-size: clamp(2.3rem, 3.2vw, 3rem); line-height: 1.12; letter-spacing: -.025em; margin: 0; }
  .journey-note { color: var(--color-text-muted); margin: 1.7rem 0 .75rem; font-size: 1.0625rem; line-height: 1.8; }
  .journey-note strong { color: var(--color-text); }
  .journey-intro .text-link { font-size: 1rem; }
  .chapter { border-top: 1px solid var(--color-border); }
  .chapter:last-child { border-bottom: 1px solid var(--color-border); }
  .chapter summary { display: grid; grid-template-columns: 2rem minmax(0,1fr) 24px; align-items: center; gap: 1rem; padding: 1.8rem 0; cursor: pointer; list-style: none; }
  .chapter summary::-webkit-details-marker { display: none; }
  .chapter-number { align-self: start; padding-top: .1rem; font-family: var(--font-serif); font-style: italic; font-size: 1.2rem; color: var(--color-primary); }
  .chapter-meta { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; font-size: .75rem; text-transform: uppercase; letter-spacing: .15em; color: var(--color-text-muted); margin-bottom: .65rem; }
  .chapter-meta > span { color: var(--color-primary); }
  .chapter-title { display: block; font-family: var(--font-serif); font-size: 2.25rem; line-height: 1.1; letter-spacing: -.02em; }
  .chapter :global(.chapter-toggle) { color: var(--color-text-muted); transition: transform .25s; stroke-width: 1; }
  .chapter[open] :global(.chapter-toggle) { transform: rotate(45deg); color: var(--color-primary); }
  .chapter[open] .chapter-title { color: var(--color-primary); }
  .chapter-body { padding: 0 0 2rem 3rem; }
  .chapter[open] .chapter-body { animation: chapter-in .3s ease-out; }
  .chapter-intro { margin: 0 0 1.8rem; color: var(--color-text-muted); font-size: 1.0625rem; line-height: 1.8; }
  .milestones { list-style: none; margin: 0; padding: 0; }
  .milestones li { position: relative; padding: 0 0 1.6rem 1.25rem; border-left: 1px solid #c6bbae; }
  .milestones li::before { content: ''; position: absolute; top: 8px; left: -3px; width: 5px; height: 5px; border-radius: 50%; background: var(--color-primary); }
  .milestone-date { font-size: .75rem; letter-spacing: .08em; color: var(--color-primary); }
  .milestones h3 { font-family: var(--font-serif); font-weight: 400; font-size: 1.35rem; margin: .5rem 0; line-height: 1.5; }
  .milestones p { margin: .5rem 0 0; color: var(--color-text-muted); font-size: 1rem; line-height: 1.8; }
  .milestones .milestone-place { font-size: .9375rem; color: #5d594f; }
  .business-value { border-top: 1px solid var(--color-border); padding-top: 1.25rem; margin-top: .25rem; }
  .business-value .eyebrow { font-size: .75rem; }
  .business-value p { font-family: var(--font-serif); font-size: 1.55rem; line-height: 1.25; margin: .8rem 0 1rem; }
  .skills { display: flex; flex-wrap: wrap; gap: .5rem 1rem; margin: 0; padding: 0; list-style: none; }
  .skills li { font-size: .75rem; color: var(--color-text-muted); }
  .skills li:not(:last-child)::after { content: '/'; padding-left: 1rem; color: #9a9186; }
  .journey-outcome { display: flex; justify-content: space-between; align-items: center; gap: 2rem; margin-top: 4rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
  .journey-outcome p { font-size: 1rem; margin: 0; }
  .journey-outcome p > span { color: var(--color-primary); }
  .journey-outcome a { max-width: 290px; }
  @keyframes chapter-in { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (max-width: 1023px) { .journey-layout { gap: 2.5rem; } .chapter-title { font-size: 1.8rem; } }
  @media (max-width: 767px) {
    .journey-layout { grid-template-columns: 1fr; gap: 2.5rem; }
    .journey-intro { position: static; padding-top: 1.25rem; }
    .journey-thought { font-size: 2.15rem; }
    .journey-note { margin: 1.25rem 0 .75rem; font-size: 1.0625rem; }
    .journey-intro .text-link { font-size: 1rem; }
    .chapter summary { grid-template-columns: 1.25rem minmax(0,1fr) 24px; gap: .7rem; padding: 1.4rem 0; }
    .chapter-title { font-size: 1.75rem; }
    .chapter-body { padding-left: 0; }
    .journey-outcome { flex-direction: column; align-items: start; gap: 1rem; margin-top: 2.5rem; }
  }


  @media (max-width: 359px) { .chapter-title { font-size: 1.55rem; } }
  .chapter-meta, .milestone-date, .milestone-place, .skills, .journey-outcome > p { font-family: var(--font-mono); }
  .journey-outcome > p { font-size: .875rem; }
</style>
