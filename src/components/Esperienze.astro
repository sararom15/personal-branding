---
const experiences = [
  {
    role: "Automation & AI Specialist",
    company: "Asernet",
    location: "Foggia",
    period: "2025 - Present",
    description: "Qui lavoro sull’integrazione tra AI, dati e marketing strategico.<br/><br/>Progetto data warehouse.<br/>Costruisco dashboard leggibili anche per chi non è tecnico.<br/>Sviluppo agenti AI che supportano analisi e operatività.<br/><br/>Il mio ruolo è rendere il dato utilizzabile.<br/>Non più un archivio.<br/>Ma uno strumento di orientamento."
  },
  {
    role: "Hyperautomation Developer",
    company: "Sprint Reply",
    location: "Milano",
    period: "2022 - 2025",
    description: "È stata la mia scuola di rigore.<br/><br/>RPA, processi enterprise, scalabilità, efficienza.<br/>Qui ho imparato che ogni automazione è prima di tutto un’analisi profonda del processo.<br/><br/>Oggi applico quella disciplina in contesti più dinamici,<br/>dove AI e strategia si intrecciano."
  }
];
---

<section id="esperienze">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Esperienze</h2>
      <p class="section-subtitle">CRESCITA, METODO E CONTAMINAZIONE</p>
    </div>
    <div class="timeline">
      {experiences.map((exp, index) => (
        <div class="timeline-item">
          <div class="timeline-dot"></div>
          <div class="timeline-content">
            <span class="period">{exp.period}</span>
            <h3>{exp.role} <span class="company">@ {exp.company}, {exp.location}</span></h3>
            <p set:html={exp.description}></p>
            {exp.details && (
              <div class="experience-details">
                {exp.details.map(detail => (
                  <div class="detail-item">
                    <h4>{detail.title}</h4>
                    <p>{detail.text}</p>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    max-width: 800px;
    margin: 3rem auto 0 auto;
    padding-left: 2rem;
    border-left: 2px solid var(--color-border);
  }

  .timeline-item {
    margin-bottom: 3rem;
    position: relative;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-dot {
    position: absolute;
    left: -2.6rem; /* Adjust based on border + padding */
    top: 0;
    width: 16px;
    height: 16px;
    background-color: var(--color-bg);
    border: 3px solid var(--color-primary);
    border-radius: 50%;
  }

  .period {
    display: inline-block;
    background-color: rgba(255, 255, 255, 0.05);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-size: 0.875rem;
    color: var(--color-primary);
    margin-bottom: 0.5rem;
    font-weight: 500;
  }

  .company {
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .timeline-content h3 {
    margin-bottom: 0.5rem;
  }

  .timeline-content p {
    color: #cccccc;
  }

  .experience-details {
    margin-top: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .detail-item h4 {
    color: var(--color-primary);
    font-size: 1rem;
    text-transform: uppercase;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .detail-item p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
</style>
