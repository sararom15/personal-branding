---
interface Props { tone?: 'terracotta' | 'ivory'; }
const { tone = 'terracotta' } = Astro.props;
---
<div class="canvas-container" aria-hidden="true">
  <canvas class="interactive-bg" data-tone={tone}></canvas>
</div>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLCanvasElement>('.interactive-bg').forEach(canvas => {
    const context = canvas.getContext('2d');
    if (!context || !canvas.parentElement) return;
    const ctx = context;
    const ink = canvas.dataset.tone === 'ivory' ? '255,249,237' : '173,78,43';
    let width = 0;
    let height = 0;
    let frame = 0;
    let visible = false;
    let last = 0;
    let phase = 0;

    function draw() {
      ctx.clearRect(0, 0, width, height);
      const rows = 6;
      for (let row = 0; row < rows; row++) {
        const baseline = height * (row + 1) / (rows + 1);
        const amplitude = Math.min(height * .055, 35);
        const wave = (x: number) => baseline + Math.sin(x / 200 + phase + row * .8) * amplitude;
        ctx.beginPath();
        for (let x = 0; x <= width + 20; x += 20) {
          if (x === 0) ctx.moveTo(x, wave(x));
          else ctx.lineTo(x, wave(x));
        }
        ctx.strokeStyle = `rgba(${ink},${row % 2 ? .08 : .14})`;
        ctx.lineWidth = 1;
        ctx.stroke();
        const packetX = ((phase * 45 + row * 177) % (width + 20)) - 10;
        ctx.fillStyle = `rgba(${ink},.4)`;
        ctx.beginPath();
        ctx.arc(packetX, wave(packetX), 2.5, 0, Math.PI * 2);
        ctx.fill();
      }
    }

    function animate(time: number) {
      frame = 0;
      if (!visible || document.hidden || reduced.matches) return;
      if (time - last >= 32) {
        phase += Math.min((time - last) / 1000, .05) * .45;
        last = time;
        draw();
      }
      frame = requestAnimationFrame(animate);
    }

    function sync() {
      if (frame) cancelAnimationFrame(frame);
      frame = 0;
      if (visible) draw();
      const running = visible && !document.hidden && !reduced.matches;
      canvas.dataset.running = String(running);
      if (running) {
        last = performance.now();
        frame = requestAnimationFrame(animate);
      }
    }

    new ResizeObserver(([entry]) => {
      width = entry.contentRect.width;
      height = entry.contentRect.height;
      const ratio = Math.min(window.devicePixelRatio || 1, 1.5);
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
      if (visible) draw();
    }).observe(canvas.parentElement);
    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      sync();
    }).observe(canvas);
    reduced.addEventListener('change', sync);
    document.addEventListener('visibilitychange', sync);
  });
</script>

<style>
  .canvas-container { position: absolute; inset: 0; overflow: hidden; pointer-events: none; z-index: 0; }
  .interactive-bg { display: block; width: 100%; height: 100%; }
</style>
