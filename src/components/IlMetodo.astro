---
const steps = [
  {
    number: "01",
    title: "Ascolto",
    description: "Prima di proporre qualsiasi cosa, capisco l'impresa: le persone, il mercato, il modo di lavorare. Si parte sempre da una chiacchierata."
  },
  {
    number: "02",
    title: "Mappa",
    description: "Individuo dove si genera attrito e dove c'è valore da liberare. Ne esce una mappa con poche priorità chiare, e con ciò che ciascuna può restituire."
  },
  {
    number: "03",
    title: "Messa a terra",
    description: "Si costruisce, un passo alla volta: interventi concreti, con obiettivi misurabili. Niente rivoluzioni che restano sulla carta."
  },
  {
    number: "04",
    title: "Autonomia",
    description: "Formo le persone e consegno gli strumenti. L'innovazione funziona davvero quando resta in azienda anche dopo di me."
  }
];
---
<section id="metodo" aria-labelledby="method-title">
  <div class="container">
    <div class="method-heading section-header">
      <div><span class="eyebrow">03 / Il metodo</span><h2 id="method-title">Una visione chiara.<br /><em>Un passo alla volta.</em></h2></div>
      <p>Ogni progetto, piccolo o grande, segue lo stesso percorso. Dalla prima domanda all’autonomia delle persone.</p>
    </div>
    <div class="method-grid">
      {steps.map((step, index) => (
        <div class="method-step" style={`--step-order: ${index}`}><div class="step-marker"><span class="step-number">{step.number}</span><span class="step-dot"></span></div><h3>{step.title}</h3><p>{step.description}</p></div>
      ))}
    </div>
  </div>
</section>
<style>
  .method-heading { display: flex; align-items: end; justify-content: space-between; gap: 4rem; }
  .method-heading > p { font-family: var(--font-mono); max-width: 340px; font-size: .9375rem; color: var(--color-text-muted); margin-bottom: .25rem; }
  .method-grid { display: grid; grid-template-columns: repeat(4,minmax(0,1fr)); gap: 2rem; margin-top: 4rem; }
  .step-marker { position: relative; display: flex; align-items: center; justify-content: space-between; padding-bottom: 1.2rem; border-bottom: 1px solid var(--color-border); margin-bottom: 1.5rem; }
  .step-number { font-family: var(--font-serif); font-size: 3rem; font-style: italic; color: var(--color-primary); line-height: 1; }
  .step-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-primary); }
  .method-step h3 { font-size: 2rem; margin-bottom: 1rem; }
  .method-step p { color: var(--color-text-muted); font-size: 1rem; line-height: 1.85; margin: 0; }
  @media (min-width: 768px) and (max-width: 1099px) { .method-grid { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 2.5rem; } }
  @media (max-width: 767px) { .method-heading { display: block; } .method-heading > p { margin-top: 1.5rem; } .method-grid { grid-template-columns: 1fr; margin-top: 2.5rem; gap: 2rem; } .step-marker { margin-bottom: 1rem; padding-bottom: .8rem; } .step-number { font-size: 2.5rem; } .method-step p { font-size: 1.0625rem; } }
  @media (prefers-reduced-motion: no-preference) {
    .step-marker::after { content: ''; position: absolute; inset: auto 0 -1px; height: 1px; background: var(--color-primary); transform: scaleX(0); transform-origin: left; pointer-events: none; }
    .method-step[data-reveal="visible"] .step-marker::after { animation: method-line .95s cubic-bezier(.22,1,.36,1) calc(var(--step-order, 0) * .12s + .2s) both; }
    .method-step[data-reveal="visible"] .step-dot { animation: method-node .65s ease-out calc(var(--step-order, 0) * .12s + .55s) both; }
  }
  @keyframes method-line { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes method-node { from { opacity: .3; transform: scale(.5); } to { opacity: 1; transform: scale(1); } }
</style>
