---
import { ArrowUp } from '@lucide/astro';
---
<button id="scroll-to-top" class="icon-button" aria-label="Torna all'inizio" title="Torna all'inizio" hidden><ArrowUp size={20} /></button>

<script>
  const button = document.querySelector<HTMLButtonElement>('#scroll-to-top');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (button) {
    let frame = 0;
    const sync = () => {
      frame = 0;
      button.hidden = window.scrollY < 500;
    };
    window.addEventListener('scroll', () => {
      if (!frame) frame = requestAnimationFrame(sync);
    }, { passive: true });
    button.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: reduced.matches ? 'instant' : 'smooth' });
      document.querySelector<HTMLAnchorElement>('.logo')?.focus({ preventScroll: true });
    });
    sync();
  }
</script>

<style>
  #scroll-to-top { position: fixed; bottom: max(20px, env(safe-area-inset-bottom)); left: 24px; z-index: 40; background: var(--color-bg); border-color: #555; box-shadow: 0 3px 14px rgb(0 0 0 / 20%); }
  #scroll-to-top[hidden] { display: none; }
  #scroll-to-top:hover { border-color: var(--color-accent); color: var(--color-accent); transform: translateY(-3px); }
  @media (max-width: 767px) { #scroll-to-top { left: 12px; bottom: max(12px, env(safe-area-inset-bottom)); } }
</style>
