---
import '../styles/global.css';
import { getImage } from 'astro:assets';
import heroImage from '../assets/sara-hero-editorial.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import PageMotion from '../components/PageMotion.astro';
import FloatingContact from '../components/FloatingContact.astro';

interface Props {
	title: string;
	description?: string;
}

const { title, description = "Personal Branding Website" } = Astro.props;
const socialImage = await getImage({ src: heroImage, width: 1200, format: 'jpg', quality: 85 });
---

<!doctype html>
<html lang="it">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content={description} />
		<meta name="viewport" content="width=device-width" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-editorial.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon-editorial.svg" />

		<meta name="theme-color" content="#f7f4ee" />
<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={new URL(Astro.url.pathname, 'https://www.romanosara.com').href} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={new URL(Astro.url.pathname, 'https://www.romanosara.com').href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(socialImage.src, 'https://www.romanosara.com').href} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={new URL(Astro.url.pathname, 'https://www.romanosara.com').href} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(socialImage.src, 'https://www.romanosara.com').href} />

    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Sara Romano",
        "jobTitle": "AI Engineer e specialista in Digital Innovation & Communication",
        "description": "AI Engineer specializzata in Intelligenza Artificiale, sviluppo di agenti AI, automazione intelligente e innovazione digitale per imprese",
        "knowsAbout": [
          "Artificial Intelligence",
          "AI Agents",
          "Generative AI",
          "Automation",
          "Machine Learning",
          "Business Model Innovation"
        ],
        "url": "https://www.romanosara.com",
        "image": "https://www.romanosara.com/Sara_SenzaBackground.png",
        "sameAs": [
          "https://www.linkedin.com/in/sara-romano-1368591b7",
          "https://github.com/sararom15",
          "https://www.instagram.com/rasa_noma/",
          "https://www.facebook.com/sara.romano.503/"
        ],
        "contactPoint": {
          "@type": "ContactPoint",
          "email": "sara.romano.15@gmail.com",
          "contactType": "customer support"
        }
      }
    </script>
	</head>
	<body>
		<Header />
		<slot />
    <ScrollToTop />
    <FloatingContact />
		<Footer />
    <PageMotion />
	</body>
</html>
