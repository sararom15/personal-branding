---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ChiSono from '../components/ChiSono.astro';
import Visione from '../components/Visione.astro';
import CosaFaccio from '../components/CosaFaccio.astro';
import Esperienze from '../components/Esperienze.astro';
import Progetti from '../components/Progetti.astro';
import Formazione from '../components/Formazione.astro';
import Contatti from '../components/Contatti.astro';
---

<Layout 
  title="Sara Romano – AI Engineer & Automation Specialist in Puglia"
  description="AI engineer e automation specialist in Puglia: sviluppo agenti AI, automazioni, data analysis e dashboarding per imprese che vogliono innovare restando umane."
>
  
  <!-- PERSISTENT AVATAR -->
  <div id="global-avatar-container">
    <div class="avatar-wrapper">
      <img src="/Sara_SenzaBackground.png" alt="Sara Romano - AI Engineer & Automation Specialist" class="avatar-img" />
      <a href="#contatti" class="avatar-btn">Let's Talk!</a>
    </div>
  </div>

	<main>
		<Hero />
    <ChiSono />
    <Visione />
    <CosaFaccio />
    <Esperienze />
    <Progetti />
    <Formazione />
    <Contatti />
	</main>
</Layout>

<script>
  // Global scroll listener for the avatar
  function updateAvatar() {
    const avatarContainer = document.getElementById('global-avatar-container');
    if (!avatarContainer) return;

    const scrolled = window.scrollY;
    // Define the range over which the transition happens (e.g., first 500px)
    const transitionRange = 600; 
    const progress = Math.min(Math.max(scrolled / transitionRange, 0), 1);

    avatarContainer.style.setProperty('--avatar-progress', progress.toString());

    // Optional: Add class 'scrolled' if we passed the hero for further CSS hooks
    if (progress >= 1) {
      avatarContainer.classList.add('is-fixed-right');
    } else {
      avatarContainer.classList.remove('is-fixed-right');
    }
  }

  window.addEventListener('scroll', updateAvatar, { passive: true });
  updateAvatar(); // Initial call
</script>

<style is:global>
  /* Global Avatar Styles */
  #global-avatar-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    pointer-events: none; /* Let clicks pass through to content */
    z-index: 5; /* Above background, below nav/modals */
    display: flex;
    align-items: center;
    justify-content: center;
    
    /* Default variable */
    --avatar-progress: 0;
  }

  .avatar-wrapper {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    width: auto;
    /* Transformation logic moved here for POSITIONING */
    /* Shared logic can go here if needed, but specific translations are in media queries */
    will-change: transform;
    transition: transform 0.1s linear;
    transform-origin: center center;
  }

  .avatar-img {
    height: 90vh;
    width: auto;
    object-fit: contain;
    will-change: transform;
    /* Scaling logic stays on image so button doesn't shrink */
    transform-origin: center center;
    
    /* Default Desktop Scale Logic */
    transform: scale(calc( 1.1 - (var(--avatar-progress) * 0.5) ));
  }

  .avatar-btn {
    pointer-events: auto; /* Enable clicks */
    margin-top: 10px;
    padding: 8px 16px;
    background-color: var(--color-primary);
    color: white;
    font-weight: 600;
    font-size: 0.9rem;
    border-radius: 20px;
    text-decoration: none;
    opacity: 0; /* Hidden initially */
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease, background-color 0.2s;
    
    /* Fade in logic based on progress */
    /* We use a CSS variable trick or just opacity calculation */
    opacity: calc( (var(--avatar-progress) - 0.8) * 5 ); /* Starts showing at 0.8, fully visible at 1.0 */
    
    /* Transform Y based on progress to "slide up" */
    transform: translateY(calc( 10px - (var(--avatar-progress) * 10px) ));
  }

  .avatar-btn:hover {
    background-color: var(--color-primary-hover);
  }

  /* BUTTON VISIBILITY LOGIC FIX */
  /* If progress < 0.8, opacity is negative -> 0. If > 1, caps at 1 implicitly by CSS rules? No, opacity clamps. */

  /* MEDIA QUERY FOR MOBILE & TABLET (Up to 1199px) */
  /* Increased breakpoint to ensure smaller laptops get the "safe" stacked layout */
  @media (max-width: 1199px) {
    #global-avatar-container {
      position: fixed; /* Keep it fixed so it stays when scrolling initially or use absolute if preferred, but fixed is better for "starting position" feel */
      height: 100dvh; /* Full viewport height */
      top: auto;
      bottom: 0;      /* Anchor to bottom */
      left: 0;
      width: 100%;
      z-index: 1001;    /* Ensure it is visible on top of text */
      justify-content: center;
      align-items: flex-end; /* Align image to bottom */
      padding-top: 0;
    }
    
    .avatar-wrapper {
      transform-origin: bottom center;
      /* Mobile Scroll Animation: Wrapper Moves */
      transform: 
        translateY(calc( 0% - (var(--avatar-progress) * 65vh) ))
        translateX(calc( 0% - (var(--avatar-progress) * 35vw) ));
    }

    .avatar-img {
      height: 65vh;   /* Reduced to keep face below the text */
      max-width: 100%;
      object-fit: contain;
      object-position: bottom center;
      
      /* Mobile Scale Logic ONLY */
      /* Crucial: transform-origin MUST be bottom center so it shrinks towards the button */
      transform-origin: bottom center; 
      transform: scale(calc( 1 - (var(--avatar-progress) * 0.7) ));
    }

    .avatar-btn {
      /* On mobile, button might need to be smaller or positioned differently */
      font-size: 0.8rem;
      padding: 6px 14px;
      /* Now that image shrinks downwards, button is naturally close. 
         Add a bit of negative margin or translation if needed to snug it up, 
         or positive margin if too close. 
         Since img is 70% shrunk, it might be weirdly close or far depending on layout.
         Testing: It should be fine. Maybe remove negative margin from before?
         User said "too much distance".
      */
      margin-top: 5px; /* Tiny gap */
      opacity: calc( (var(--avatar-progress) - 0.9) * 10 ); /* Show very late */
      /* Ensure it stays readable */
      white-space: nowrap;
    }
  }

  /* MEDIA QUERY FOR LARGE DESKTOP (1200px and up) */
  @media (min-width: 1200px) {
    /* 
       Desktop Layout:
       - Content (.container): Takes up 70% of the width on the left.
    */
    .container {
      max-width: 70%; /* Increased to 70% */
      margin-left: 0; /* Align to left edge (with padding handled by container class) */
      margin-right: auto;
      padding-right: 2rem;
      /* Add some left padding to not stick to edge */
      padding-left: 4rem; 
    }

    /* 
      Hero Exception: 
      The Hero text needs to be centered/overlap the centered avatar. 
      So we reset it to be full width/centered.
    */
    #hero .container {
       max-width: var(--container-width);
       width: 100%;
       padding-left: 1.5rem; /* Reset padding */
       padding-right: 1.5rem;
       margin: 0 auto; /* Center it */
    }
    
    /* Desktop Wrapper Logic */
    .avatar-wrapper {
        margin-top: 4vh; /* Lower initial position */
        transform: 
          translateX(calc( 0% + (var(--avatar-progress) * 35vw) )) 
          translateY(calc( 0% + (var(--avatar-progress) * 6vh) )); /* Reduced scroll push */
    }
    
    /* Desktop Image Scale */
     .avatar-img {
        /* Revert to default "center center" to fix initial hero position */
        transform-origin: center center; 
        transform: scale(calc( 1.1 - (var(--avatar-progress) * 0.5) ));
     }

    /* Desktop Button Gap Fix via Translation */
    /* Reducing lift to 18.5vh to avoid overlapping icon ("non sovrapposto") */
    .avatar-btn {
       transform: translateY(calc( 10px - (var(--avatar-progress) * 18.5vh) ));
    }
  }
</style>
