import CosaFaccio from '../components/CosaFaccio.astro';
import IlMetodo from '../components/IlMetodo.astro';
import Esperienze from '../components/Esperienze.astro';
import Contatti from '../components/Contatti.astro';
---

<Layout
  title="Sara Romano | AI Engineer | Digital Innovation & Communication | Puglia"
  description="AI Engineer e specialista in Digital Innovation & Communication in Puglia. Sviluppo agenti AI, automazioni e strategie digitali per imprese che vogliono innovare restando umane."
>
  <main id="main-content" tabindex="-1">
    <Hero />
    <ChiSono />
    <CosaFaccio />
    <IlMetodo />
    <Esperienze />
    <Contatti />
  </main>
</Layout>
