---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ChiSono from '../components/ChiSono.astro';
import Visione from '../components/Visione.astro';
import CosaFaccio from '../components/CosaFaccio.astro';
import Esperienze from '../components/Esperienze.astro';
import Progetti from '../components/Progetti.astro';
import Formazione from '../components/Formazione.astro';
import Contatti from '../components/Contatti.astro';
---

<Layout 
  title="Sara Romano – AI Engineer & Automation Specialist in Puglia"
  description="AI engineer e automation specialist in Puglia: sviluppo agenti AI, automazioni, data analysis e dashboarding per imprese che vogliono innovare restando umane."
>
  
  <!-- PERSISTENT AVATAR -->
  <div id="global-avatar-container">
    <img src="/Sara_SenzaBackground.png" alt="Sara Romano - AI Engineer & Automation Specialist" class="avatar-img" />
  </div>

	<main>
		<Hero />
    <ChiSono />
    <Visione />
    <CosaFaccio />
    <Esperienze />
    <Progetti />
    <Formazione />
    <Contatti />
	</main>
</Layout>

<script>
  // Global scroll listener for the avatar
  function updateAvatar() {
    const avatarContainer = document.getElementById('global-avatar-container');
    if (!avatarContainer) return;

    const scrolled = window.scrollY;
    // Define the range over which the transition happens (e.g., first 500px)
    const transitionRange = 600; 
    const progress = Math.min(Math.max(scrolled / transitionRange, 0), 1);

    avatarContainer.style.setProperty('--avatar-progress', progress.toString());

    // Optional: Add class 'scrolled' if we passed the hero for further CSS hooks
    if (progress >= 1) {
      avatarContainer.classList.add('is-fixed-right');
    } else {
      avatarContainer.classList.remove('is-fixed-right');
    }
  }

  window.addEventListener('scroll', updateAvatar, { passive: true });
  updateAvatar(); // Initial call
</script>

<style is:global>
  /* Global Avatar Styles */
  #global-avatar-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    pointer-events: none; /* Let clicks pass through to content */
    z-index: 5; /* Above background, below nav/modals */
    display: flex;
    align-items: center;
    justify-content: center;
    
    /* Default variable */
    --avatar-progress: 0;
  }

  .avatar-img {
    height: 90vh;
    width: auto;
    object-fit: contain;
    will-change: transform;
    transition: transform 0.1s linear;

    /* 
      TRANSFORMATION LOGIC
      
      START (Progress 0):
      - Center screen
      - Scale 1.1
      - TranslateX 0
      - TranslateY 0

      END (Progress 1):
      - Positioned on Right side (e.g., 35vw)
      - Positioned at BOTTOM (TranslateY +25vh approx)
      - Scale 0.6
    */
    transform: 
      translateX(calc( 0% + (var(--avatar-progress) * 35vw) )) 
      translateY(calc( 0% + (var(--avatar-progress) * 25vh) ))
      scale(calc( 1.1 - (var(--avatar-progress) * 0.5) ));
    
    transform-origin: center center;
  }

  /* MEDIA QUERY FOR MOBILE & TABLET (Up to 1200px) */
  /* Increased breakpoint to ensure smaller laptops get the "safe" stacked layout */
  @media (max-width: 1199px) {
    #global-avatar-container {
      position: fixed; /* Keep it fixed so it stays when scrolling initially or use absolute if preferred, but fixed is better for "starting position" feel */
      height: 100dvh; /* Full viewport height */
      top: auto;
      bottom: 0;      /* Anchor to bottom */
      left: 0;
      width: 100%;
      z-index: 0;    /* Move behind content (z-index 10) */
      justify-content: center;
      align-items: flex-end; /* Align image to bottom */
      padding-top: 0;
    }
    
    .avatar-img {
      height: 65vh;   /* Reduced to keep face below the text */
      width: auto;
      max-width: 100%;
      object-fit: contain;
      object-position: bottom center;
      
      /* Mobile Scroll Animation: move to Top-Left */
      /* 
         Logic:
         - Start (0): Bottom Center
         - End (1): Top Left, Scale 0.3
         - TranslateY: Move UP by less distance to stay below header (was 85vh, now 75vh).
         - TranslateX: Move LEFT by 35vw.
      */
      transform: 
        translateY(calc( 0% - (var(--avatar-progress) * 75vh) ))
        translateX(calc( 0% - (var(--avatar-progress) * 35vw) ))
        scale(calc( 1 - (var(--avatar-progress) * 0.7) ));
      
      transform-origin: bottom center; 
      opacity: 1; 
      pointer-events: none; /* Ensure clicks pass through */
      z-index: 1000; /* Bring it to front (above text content) but check against header (also 1000) */
    }
    
    /* Ensure it is above the header if desired, or below? 
       If header is 1000, and this is 1000, stacking order depends on DOM.
       Header is usually top of DOM? No, Layout puts Header first.
       So this comes AFTER header in DOM (inside main usually? No, global-avatar is outside main).
       Wait, global-avatar is inside Layout, before main.
       Header is inside Layout, before slot.
       
       Structure:
       Layout
         Head
         Body
           Header
           global-avatar-container
           Main
           Footer
       
       So global-avatar is AFTER Header. z-index 1000 vs 1000 -> Avatar wins (on top).
       Use z-index 1001 to be safe if we want it ON TOP.
       Use z-index 999 if we want it BELOW.
       
       User said "sotto l'header" (under the header) as a problem.
       I'll try z-index 1002 to prove it can be seen, or adjust Y to be physically below.
       
       Let's stick to "Small top-left" (piccola in alto a sx).
       If I put it Z-1002, it covers the Logo/Menu? 
       The Logo is on the Left. The Menu is on the Right.
       Top Left = Logo.
       
       Maybe I should move it to Center-Left or just below the header?
       
       Let's try positioning it visibly below the header first (Y adjustment).
    */
    #global-avatar-container {
      /* ... existing styles ... */
      z-index: 1001; /* Ensure it is visible on top of text */
    }
  }

  /* MEDIA QUERY FOR LARGE DESKTOP (1200px and up) */
  @media (min-width: 1200px) {
    /* 
       Desktop Layout:
       - Content (.container): Takes up 70% of the width on the left.
    */
    .container {
      max-width: 70%; /* Increased to 70% */
      margin-left: 0; /* Align to left edge (with padding handled by container class) */
      margin-right: auto;
      padding-right: 2rem;
      /* Add some left padding to not stick to edge */
      padding-left: 4rem; 
    }

    /* 
      Hero Exception: 
      The Hero text needs to be centered/overlap the centered avatar. 
      So we reset it to be full width/centered.
    */
    #hero .container {
       max-width: var(--container-width);
       width: 100%;
       padding-left: 1.5rem; /* Reset padding */
       padding-right: 1.5rem;
       margin: 0 auto; /* Center it */
    }
  }
</style>
